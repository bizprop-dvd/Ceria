# RevenueCat PUBLIC SDK keys (safe to ship in the app binary).
# Get them from the RevenueCat dashboard → Project → API keys.
# Copy this file to `.env` and fill in the values before building native apps.
#
# In the browser (`npm run dev`) these are ignored — the purchase flow uses a
# local mock so the whole freemium experience is testable without a store.

VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Google Drive backup (optional). Leave blank and the app hides Drive entirely;
# the manual backup file keeps working either way.
#
# From Google Cloud Console → APIs & Services → Credentials, create an OAuth
# client for iOS and one for Android. There is no client secret: a secret
# shipped inside a downloadable app is not a secret, so this uses PKCE.
#
# Enable the Google Drive API for the project, and on the OAuth consent screen
# request ONLY the `drive.file` scope — access to files this app created. Wider
# Drive scopes put the project in Google's restricted tier, which requires a
# paid third-party security assessment every year.
#
# The redirect scheme is the iOS client id reversed, e.g.
#   client id  123456-abc.apps.googleusercontent.com
#   scheme     com.googleusercontent.apps.123456-abc
# Register it as a URL scheme on iOS and as an intent filter on Android.

VITE_GOOGLE_IOS_CLIENT_ID=
VITE_GOOGLE_ANDROID_CLIENT_ID=
VITE_GOOGLE_REDIRECT_SCHEME=
