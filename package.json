{
  "name": "ceria-family-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ceria Family App — Toolkit, Guidebook, and 52-week Diary for Yayasan Sukacita Keluarga Indonesia",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:preview": "vite build --config vite.preview.config.ts",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "gen:diary": "node content/_generators/gen_diary.mjs",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "assets:source": "python3 assets/_generate_assets.py",
    "assets:generate": "capacitor-assets generate --assetPath assets"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "^6.0.4",
    "@revenuecat/purchases-capacitor": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  }
}
