# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Capacitor native platforms.
#
# android/ IS tracked. It is where the app's icons, splash screens, permissions
# and notification icon live, so regenerating it on every build would mean
# losing anything set there. Its own .gitignore already keeps the build output
# and the copied web assets out.
#
# ios/ is not here yet — it needs a Mac to generate. Track it too when it is.
ios/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.local
.env.*.local

# Python bytecode
__pycache__/
*.pyc
preview-dist/

# Generated by build_artifact_page.py on every preview build; 1.8 MB that
# changes wholesale each time. Rebuild with:
#   npm run build:preview && python3 content/_source/build_artifact_page.py
content/_source/out/ceria-app.html
content/_source/out/illustration-brief.html
